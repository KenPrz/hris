# .env.prod.example — the production stack (`make prod-up`, compose.prod.yml).
# Copy to `.env` in this same directory (gitignored) and fill in. Compose reads `.env`
# from the directory it is invoked from, so it must sit beside compose.prod.yml.
#
# Note: this is the SAME `.env` file the dev stack reads. The two use different variable
# names throughout (HRIS_DEV_* for dev, HRIS_* here) precisely so one file can hold both
# without either stack picking up the other's database password by accident.

# --- Required ------------------------------------------------------------

# Postgres password for the prod db container. Pick a real secret — not dev's
# throwaway "hris" default. The postgres image refuses to start without one.
HRIS_DB_PASSWORD=

# Laravel APP_KEY. Mint one with `make dev-key` and paste the `base64:...` value here
# (the key format has nothing to do with which environment it is used in).
HRIS_APP_KEY=

# The one public hostname. HRIS has a single frontend on purpose, so unlike ../pos
# there is one domain, not two: Caddy serves /api/* from PHP and everything else from
# Next behind it. Needs DNS pointing at this host and 80/443 reachable from the
# internet for ACME to issue a real certificate.
#
# For a domainless local smoke test use hris.localhost (which resolves to 127.0.0.1
# with no /etc/hosts edit) together with HRIS_TLS_ISSUER=internal below.
HRIS_DOMAIN=

# The company name this deployment is for. Required — AppServiceProvider refuses to
# boot without it.
HRIS_ORGANIZATION_NAME=

# Credentials for the RustFS object store that holds request attachments. Any
# non-empty pair; they never leave the compose network (rustfs publishes no ports).
HRIS_RUSTFS_KEY=
HRIS_RUSTFS_SECRET=

# --- Optional ------------------------------------------------------------

# ISO 4217 currency. Defaults to PHP, which is almost certainly what you want.
# HRIS_CURRENCY=PHP

# Certificate issuer for Caddy's automatic TLS. Default "acme" means real certificates
# from Let's Encrypt, requiring DNS + reachable 80/443. Set to "internal" for a
# domainless local boot (hris.localhost): Caddy mints from its own CA, so curl needs -k.
# HRIS_TLS_ISSUER=acme

# Run `php artisan migrate --force` on every api container boot. Default 1 (on); set to
# 0 once you would rather run migrations by hand.
# HRIS_MIGRATE_ON_BOOT=1

# There is no QUEUE_CONNECTION here on purpose: compose.prod.yml sets it literally in the
# api/queue `environment:` block (this file only feeds ${HRIS_*} interpolation, so a value
# here would never reach the container). The `queue` service must be running — RecomputeDay
# implements ShouldQueue, so without a worker every recompute after a holiday edit, a
# pay-rule change, or an approval queues into a table nothing drains. `make prod-queue-logs`.

# Minutes until an API token expires. Optional — compose defaults to 720 (12 hours), which
# covers one working day plus a margin. Sanctum's own default is null, meaning never, which
# is what config/sanctum.php exists to override.
# HRIS_SANCTUM_EXPIRATION_MINUTES=720
