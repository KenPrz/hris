# Kept out of the build context. The prod stage is `COPY . .`, so this file is a
# security boundary, not tidiness: without it the host's .env — a real APP_KEY and a
# real database password — is baked into an image layer, and the host's vendor/ (dev
# dependencies included) lands on top of the --no-dev tree the `vendor` stage built.
.env
.env.*
!.env.example
vendor/
node_modules/
.git/
.gitignore
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
# The package-discovery cache, generated by a DEV `composer install` and therefore
# listing dev-only providers. Baked into a --no-dev image it hard-fails every boot with
# `Class "Laravel\Pail\PailServiceProvider" not found` — laravel/pail is require-dev, so
# the provider it names is genuinely absent. Excluded, Laravel re-discovers at boot
# against the packages actually installed. The `*.php` glob keeps the directory itself
# (the prod stage chowns it).
bootstrap/cache/*.php
# Vite dev-server artifacts. `public/hot` in particular makes every @vite() asset URL
# point at a dev server on the builder's laptop.
public/hot
public/build
public/storage
.phpunit.cache/
.phpunit.result.cache
tests/
Dockerfile
.dockerignore
